<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude credential-bearing Preferences DataStore (Spotify OAuth + Last.fm / ListenBrainz tokens) -->
        <exclude domain="file" path="datastore/nothing_chord_prefs.preferences_pb" />
        <!-- Exclude large local offline audio vault files from cloud backup -->
        <exclude domain="file" path="nchord_offline_vault" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude OAuth & scrobbler session tokens during device-to-device transfer -->
        <exclude domain="file" path="datastore/nothing_chord_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
