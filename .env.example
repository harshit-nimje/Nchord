# NothingChord uses zero hardcoded or bundled developer API keys.
# Users configure their own Spotify Client ID, YouTube Music bridge, or ListenBrainz token directly inside the app.
# Optional: For official Last.fm API v2.0 mobile scrobbling, set these in the AI Studio Secrets panel:
LASTFM_API_KEY=YOUR_LASTFM_API_KEY
LASTFM_SHARED_SECRET=YOUR_LASTFM_SHARED_SECRET
